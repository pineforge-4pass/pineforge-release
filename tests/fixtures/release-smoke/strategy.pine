//@version=6
strategy("Release readiness", initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1)
entryLevel = input.float(101, "Entry Level", minval=101, maxval=103, step=1)
exitLevel = input.float(99, "Exit Level", minval=98, maxval=100, step=1)
if close >= entryLevel and strategy.position_size <= 0
    strategy.entry("L", strategy.long)
if close <= exitLevel and strategy.position_size > 0
    strategy.close("L")
