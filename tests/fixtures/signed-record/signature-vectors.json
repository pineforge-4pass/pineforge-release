  "how_to_read": "Each case starts from base.record_json, applies record_edits (every find must occur exactly once) or replaces it with record_json, and builds envelope_json from the template. mutates says what the case changes: none, record-representation (the signed value is unchanged: the hub may accept, or refuse the spelling, but must never call it a bad signature), record-value (the signed value changed: bad signature), signature, key, envelope, or signed-semantics (a correctly signed record that the caller must still refuse). hub is the decision of scripts/release_signed_record.py. app is what the pinned App verifyEnvelope() decides: accept, reject, or unspecified when the behavior is not pinned.",
  "tokens": {
    "__RECORD__": "the case's record text",
    "__SIGNATURE__": "base64 Ed25519 signature by test key signer over the canonical bytes of the signed record (the base record, or the case's own record when sign_case_record is true)",
    "__SIGNATURE_OTHER__": "the same signature made by test key other",
    "__SIGNATURE_ZERO__": "base64 of 64 zero bytes",
    "__SIGNATURE_BITFLIP__": "__SIGNATURE__ with the lowest bit of its first byte flipped",
    "__SIGNATURE_TRUNCATED__": "base64 of the first 63 bytes of __SIGNATURE__",
    "__SIGNATURE_UNPADDED__": "__SIGNATURE__ without its trailing padding",
    "__SIGNATURE_S_PLUS_L__": "the signature with its scalar S replaced by S + L (L is the Ed25519 group order), 64 bytes, base64",
    "__OTHER_PUBLIC_KEY__": "base64 DER SubjectPublicKeyInfo of test key other"
